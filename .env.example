# ===== LLM 推理 (M5) =====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MODE=fake
# LLM_MODE=real  # 接 Ollama 时改 real

# ===== 向量化 (M2) =====
EMBED_MODEL=nomic-embed-text
EMBED_MODE=fake
# EMBED_MODE=real
EMBED_DIM=768

# ===== 向量库 (M3) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chenxing_docs
VECTOR_MODE=memory
# VECTOR_MODE=qdrant

# ===== 重排 (M4) =====
RERANK_MODE=none
# RERANK_MODE=cross-encoder

# ===== 鉴权 =====
